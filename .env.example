# ==========================================
# Manga Shelf 2.0 - Environment Configuration
# ==========================================

# Server Port (Pterodactyl Panel sets this via environment or default 3000)
PORT=3000
# Port aus dem Pterodactyl-Panel; hat Vorrang vor PORT. Ein ungültiger Port (erlaubt 0 bis 65535) verhindert den Start.
# SERVER_PORT=25565

# Datenordner für Datenbank, Uploads, Backups und secret.key (optional, Standard: data/ im App-Verzeichnis)
# DATA_DIR=/app/data

# Sitzungs-Cookie nur über HTTPS senden und HSTS setzen (optional, Standard false). Einschalten, wenn der Server nur
# über HTTPS erreichbar ist (z. B. hinter einem Reverse Proxy mit TLS). Akzeptiert auch 1/yes/on/ja.
# COOKIE_SECURE=true

# Natives HTTPS (optional): Liegen Schlüssel und Zertifikat vor, startet der Server direkt mit HTTPS. Standard
# ssl/privkey.pem und ssl/fullchain.pem (sonst ssl/cert.pem) im App-Verzeichnis.
# SSL_KEY_PATH=/etc/letsencrypt/live/manga.example.com/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/manga.example.com/fullchain.pem

# Signatur-Schlüssel der Sitzungen (optional, mind. 32 Zeichen, z. B. `openssl rand -hex 32`). Platzhalter-Werte werden
# abgelehnt. Ohne Angabe erzeugt der Server beim ersten Start einen zufälligen Schlüssel in <DATA_DIR>/secret.key
# (Rechte 0600). Er liegt bewusst nicht in der Datenbank und damit in keinem Backup-ZIP; wer den ganzen data-Ordner
# kopiert, kopiert ihn mit. Datei löschen = neuer Schlüssel, alle Sitzungen enden.
# Beim Update von einer Version, die den Schlüssel in der Datenbank hatte, wird er einmalig erneuert (alle Benutzer
# müssen sich neu anmelden); alte Backups enthalten damit keinen gültigen Schlüssel mehr.
# JWT_SECRET=

# Reverse Proxy (optional): Welche Proxys die Client-Adresse per X-Forwarded-For setzen dürfen (Login-Rate-Limit und
# Sperren hängen daran). Standard "loopback": nur ein Proxy auf demselben Host. Hinter einem anderen Proxy dessen
# Adresse oder Subnetz eintragen (z. B. "loopback, 172.18.0.0/16"), sonst teilen sich alle Clients ein Login-Limit.
# Der Port dieses Servers darf dann nur über den Proxy erreichbar sein (Docker: "127.0.0.1:3000:3000" statt
# "3000:3000"; veröffentlichte Docker-Ports umgehen ufw/firewalld). Eine Hop-Zahl (1) vertraut jedem, der sich
# verbindet: wer den Port direkt erreicht, kann eine fremde Adresse vortäuschen und deren Login sperren.
# Private Netze nicht pauschal freigeben: IPv6-Clients über docker-proxy erscheinen als Gateway-Adresse (z. B.
# 172.17.0.1) und könnten sich so jede Adresse aussuchen. Weitere Werte: false (kein Proxy), true (jedem vertrauen,
# nur wenn der Server ausschließlich über den Proxy erreichbar ist). yes/no/on/off werden akzeptiert; ungültige Werte
# verhindern den Start ("TRUST_PROXY ungültig").
# TRUST_PROXY=loopback, 172.18.0.0/16

# Ersteinrichtung (optional): Solange es kein Admin-Konto gibt, verlangt die Einrichtung einen Einrichtungscode. Ohne
# Angabe erzeugt der Server beim Start einen zufälligen Code und gibt ihn in der Konsole aus; SETUP_TOKEN gibt ihn fest
# vor (z. B. für automatisierte Installationen). Nach dem Anlegen des ersten Admins wird er nicht mehr gebraucht.
# Mindestens 12 Zeichen (Leerzeichen und Bindestriche zählen nicht, Groß-/Kleinschreibung egal); kürzere Werte werden
# ignoriert und der generierte Code gilt.
# SETUP_TOKEN=

# CORS (optional): Das mitgelieferte Frontend muss vom selben Ursprung wie die API kommen (dieser Server, ein Reverse
# Proxy oder im Dev-Modus der Vite-Proxy) und braucht kein CORS_ORIGIN. Nur für externe Clients auf einem anderen
# Ursprung (kommagetrennt); diese müssen credentials: 'include' senden, und das SameSite=Lax-Cookie erreicht sie nur
# innerhalb derselben Site. Schreibende API-Anfragen, die ein Browser von einem anderen Ursprung schickt, lehnt der
# Server ab; nur die hier eingetragenen Ursprünge sind davon ausgenommen.
# CORS_ORIGIN=https://tools.example.org

# Ursprünge der Apps (optional, kommagetrennt): Die iOS-, Android- und Desktop-App melden sich mit einem Bearer-Token
# an (nie mit dem Cookie) und bekommen dafür CORS ohne Credentials. Standard: capacitor://localhost (iOS),
# https://localhost (Android), ionic://localhost (ältere Ionic-Hüllen), app://manga-shelf (Desktop). Eine eigene Liste
# ersetzt den Standard; none schaltet die App-Zugänge ab, wenn keine App genutzt wird.
# APP_ORIGINS=capacitor://localhost,https://localhost

# Frontend-Build (optional): Pfad zum gebauten Frontend, Standard frontend/dist, dann dist/. Das App-Verzeichnis selbst
# wird nie ausgeliefert.
# FRONTEND_DIR=

# Backups (optional): Anzahl der vorgehaltenen Server-Snapshots, je 1 bis 1000; größere Werte gelten als 1000 (mit
# Warnung beim Start), ungültige als Standard
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_MANUAL=10
# Sicherungen vor einer Wiederherstellung (vor-wiederherstellung-*) und vor einem Update (vor-update-*); solange sie
# liegen, behält die nächtliche Aufräumung auch die Bilder, die sie nennen
# BACKUP_KEEP_PRE_RESTORE=3
# BACKUP_KEEP_PRE_UPDATE=3
# Stunde (0-23) und Zeitzone des täglichen Snapshots; eine unbekannte Zeitzone gilt als UTC
# BACKUP_HOUR=3
# BACKUP_TIMEZONE=Europe/Berlin

# Grenzen beim Wiederherstellen eines Backup-ZIPs (optional): entpackte Datenbank (Standard 2 GiB), alle Bilder
# zusammen (Standard 4 GiB) und Anzahl der Einträge im ZIP (Standard 100000), Bytes als ganze Zahl
# RESTORE_MAX_DB_BYTES=2147483648
# RESTORE_MAX_UPLOADS_BYTES=4294967296
# RESTORE_MAX_ENTRIES=100000

# Admin-Konsole auf stdin (optional, Standard true): Befehle wie "status", "backup", "passwort-reset <name>" oder
# "rollback-aufraeumen" direkt in der Server-Konsole (Pterodactyl, docker attach). false schaltet sie ab; dieselben
# Befehle gehen dann über "node scripts/admin.js <befehl>".
# ADMIN_CONSOLE=true

# Zeitzone für "heute" im Release-Radar (optional, Standard Europe/Berlin)
# APP_TIMEZONE=Europe/Berlin

# Logging (optional)
# LOG_LEVEL: debug | info (Standard) | warn | error | silent. `debug` schreibt zusätzlich ein Zugriffs-Log der API
#            (Methode, Pfad ohne Query, Status, Dauer – nie Passwörter, Cookies oder Request-Bodies).
# LOG_FORMAT: text (Standard, gut lesbar in der Pterodactyl-Konsole) | json (eine Zeile pro Eintrag, für Log-Tools)
# LOG_LEVEL=info
# LOG_FORMAT=text

# Remote-Skripte (scripts/check-remote.js, seed-remote.js, verify-remote.js); der Server selbst liest diese Werte nie.
# Ziel: Argument > REMOTE_URL > REMOTE_HOST/REMOTE_PORT. Passwörter nur über https oder an localhost.
# REMOTE_URL=https://manga.example.com
# REMOTE_HOST=localhost
# REMOTE_PORT=3000
# REMOTE_USER=admin
# REMOTE_PASS=
# REMOTE_ALLOW_HTTP=1   # erlaubt reines http zu einem anderen Host (Passwort im Klartext)
# seed-remote.js überspringt vorhandene Demo-Reihen; --wipe legt sie neu an (fragt nach, ohne Terminal nur mit --yes).

# Headless Browser Testing (optional overrides for CI/CD)
# CHROME_BIN=/usr/bin/google-chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
