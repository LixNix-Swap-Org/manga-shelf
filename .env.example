# ==========================================
# Manga Shelf 2.0 - Environment Configuration
# ==========================================

# Server Port (Pterodactyl Panel sets this via environment or default 3000)
PORT=3000

# JSON Web Token Secret (optional, mind. 32 Zeichen, z. B. `openssl rand -hex 32`).
# Ohne Angabe wird automatisch ein zufälliges Secret erzeugt und in der Datenbank gespeichert.
# Platzhalter-Werte werden abgelehnt.
# JWT_SECRET=

# Reverse Proxy (optional): Standard `true` vertraut jedem X-Forwarded-For-Header. Ohne Proxy davor (direkter Zugriff, z. B. Pterodactyl-Port)
# kann ein Client damit seine IP fälschen. TRUST_PROXY=false (kein Proxy), 1 (ein Proxy), oder Subnetze: "loopback, 172.16.0.0/12".
# TRUST_PROXY=true

# Logging (optional)
# LOG_LEVEL: debug | info (Standard) | warn | error | silent. `debug` schreibt zusätzlich ein Zugriffs-Log der API
#            (Methode, Pfad ohne Query, Status, Dauer – nie Passwörter, Cookies oder Request-Bodies).
# LOG_FORMAT: text (Standard, gut lesbar in der Pterodactyl-Konsole) | json (eine Zeile pro Eintrag, für Log-Tools)
# LOG_LEVEL=info
# LOG_FORMAT=text

# Remote Instance Sync & Testing (optional, used by check-remote.js, seed-remote.js, verify-remote.js)
REMOTE_HOST=localhost
REMOTE_PORT=3000
ADMIN_USER=admin
ADMIN_PASS=

# Headless Browser Testing (optional overrides for CI/CD)
# CHROME_BIN=/usr/bin/google-chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
