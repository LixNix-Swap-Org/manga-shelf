# Manga Shelf: environment variables
# Place as .env in the working directory of the server (Pterodactyl ZIP: next to index.js; headless server: in the data
# folder); environment variables that are already set win.
# Every value is optional. Overview: README, section 5 (Configuration).

# Port of the server (default 3000)
PORT=3000
# Port from the Pterodactyl panel; wins over PORT. An invalid port (0 to 65535 allowed) prevents the start.
# SERVER_PORT=25565

# Data folder for database, uploads, backups and secret.key (optional, default: data/ in the app directory)
# DATA_DIR=/app/data

# Send the session cookie only over HTTPS and set HSTS (optional, default false). Only needed behind a TLS proxy that
# does not send X-Forwarded-Proto; behind nginx/Caddy from the templates and with native HTTPS the server detects
# HTTPS by itself.
# Caution: with true, signing in over plain HTTP no longer works (the browser drops the cookie). Also accepts
# 1/yes/on/ja.
# COOKIE_SECURE=true

# Native HTTPS (optional): when key and certificate exist, the server starts directly with HTTPS. Default
# ssl/privkey.pem and ssl/fullchain.pem (otherwise ssl/cert.pem) in the app directory; for the headless server
# <data folder>/ssl/ (give your own paths there as absolute paths). HTTPS then runs on the same port
# (no additional HTTP port, no redirect); the start line still says http://0.0.0.0:<port> because the
# Pterodactyl egg waits for exactly this text. If the certificate cannot be loaded, the server keeps running with HTTP
# (only one line in the log).
# SSL_KEY_PATH=/etc/letsencrypt/live/manga.example.com/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/manga.example.com/fullchain.pem

# Signing key of the sessions (optional, at least 32 characters, e.g. `openssl rand -hex 32`). Placeholder values are
# rejected. Without it the server creates a random key in <DATA_DIR>/secret.key at the first start
# (permissions 0600). It deliberately does not live in the database and therefore in no backup ZIP; whoever copies the
# whole data folder copies it along. Deleting the file = a new key, every session ends.
# When updating from a version that kept the key in the database, it is renewed once (every user has to sign in
# again); old backups then contain no valid key any more.
# JWT_SECRET=

# Reverse proxy (optional): which proxies may set the client address via X-Forwarded-For (the login rate limit and
# locks depend on it). Default "loopback": only a proxy on the same host. Behind another proxy enter its address,
# otherwise all clients share one login limit. Proxy on the host in front of Docker/Pterodactyl: only the gateway
# address of the Docker network (Pterodactyl "loopback, 172.18.0.1"; Docker: docker network inspect <network> ->
# Gateway). A subnet only for a network of its own in which only the proxy container and the app hang.
# The port of this server then has to be reachable only through the proxy (Docker: "127.0.0.1:3000:3000" instead of
# "3000:3000"; published Docker ports bypass ufw/firewalld). A hop count (1) trusts anyone who
# connects: whoever reaches the port directly can fake a foreign address and lock its login.
# Do not open up private networks wholesale, and use the gateway address only with a port bound to 127.0.0.1: IPv6
# clients via docker-proxy appear as the gateway address (e.g. 172.17.0.1) and could otherwise pick any address.
# Further values: false (no proxy), true (trust everyone, only when the server is reachable exclusively through the
# proxy). yes/no/on/off are accepted; invalid values prevent the start ("TRUST_PROXY ungültig").
# TRUST_PROXY=loopback, 172.18.0.1

# General request limit (optional, default 1200): RATE_LIMIT_UMBRELLA requests per client and minute to /api, 2.5 times
# as many for the web app's files and 20 times as many for covers under /uploads (an app takes over every cover at
# once). Generous enough for a household behind a proxy that TRUST_PROXY does not cover (all clients then share one
# budget); above it the server answers 429 with Retry-After. 0 to 100000, 0 switches it off; the strict limits for
# login, setup and external lookups stay in force either way.
# RATE_LIMIT_UMBRELLA=1200

# First setup (optional): as long as there is no admin account, the setup requires a setup code. Without a value
# the server generates a random code at startup and prints it in the console; SETUP_TOKEN fixes it in advance
# (e.g. for automated installations). After the first admin has been created it is no longer needed.
# At least 12 characters (spaces and hyphens do not count, case does not matter); shorter values are
# ignored and the generated code applies.
# SETUP_TOKEN=

# CORS (optional): the bundled frontend has to come from the same origin as the API (this server, a reverse
# proxy or the Vite proxy in dev mode) and needs no CORS_ORIGIN. Only for external clients on another
# origin (comma-separated); they have to send credentials: 'include', and the SameSite=Lax cookie only reaches them
# within the same site. The server rejects writing API requests that a browser sends from another origin; only the
# origins entered here are exempt.
# CORS_ORIGIN=https://tools.example.org

# Origins of the apps (optional, comma-separated): the iOS, Android and desktop apps sign in with a bearer token
# (never with the cookie) and get CORS without credentials for that. Default: capacitor://localhost (iOS),
# https://localhost (Android), ionic://localhost (older Ionic shells), app://manga-shelf (desktop). A list of your own
# replaces the default; none switches the app access off when no app is used.
# APP_ORIGINS=capacitor://localhost,https://localhost

# Frontend build (optional): path to the built frontend, default frontend/dist, then dist/. The app directory itself
# is never delivered.
# FRONTEND_DIR=

# Backups (optional): number of server snapshots kept, 1 to 1000 each; larger values count as 1000 (with a
# warning at startup), invalid ones as the default
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_MANUAL=10
# Backups before a restore (vor-wiederherstellung-*) and before an update (vor-update-*); as long as they
# exist, the nightly cleanup also keeps the images they name
# BACKUP_KEEP_PRE_RESTORE=3
# BACKUP_KEEP_PRE_UPDATE=3
# Hour (0-23) and time zone of the daily snapshot; an unknown time zone counts as UTC
# BACKUP_HOUR=3
# BACKUP_TIMEZONE=Europe/Berlin

# Backup before an update (optional, default false): before pending database migrations the server writes
# backups/vor-update-v<old>-auf-v<new>-….zip. If that fails (disk full, backups/ read-only), the start
# aborts before the migrations. Only whoever deliberately wants to migrate without this backup sets the switch (once):
# MIGRATE_WITHOUT_SNAPSHOT=1

# Limits when restoring a backup ZIP (optional): unpacked database (default 2 GiB), all images
# together (default 4 GiB) and number of entries in the ZIP (default 100000), bytes as a whole number
# RESTORE_MAX_DB_BYTES=2147483648
# RESTORE_MAX_UPLOADS_BYTES=4294967296
# RESTORE_MAX_ENTRIES=100000

# Admin console on stdin (optional, default true): commands such as "status", "backup", "passwort-reset <name>" or
# "rollback-aufraeumen" directly in the server console (Pterodactyl, terminal of the headless server; Docker via
# docker attach only with stdin_open: true and tty: true in the compose file). false switches it off; the same commands
# always work through "node scripts/admin.js <command>" (Docker: docker exec -it -u node manga-shelf node scripts/admin.js
# <command>). The command names are German.
# ADMIN_CONSOLE=true

# Update notice (optional, default true): the page "System" (admins) asks GitHub for the newest version at most once
# a day, only while an admin has it open. false switches the query off (no connection to GitHub).
# UPDATE_CHECK=true

# Time zone for "today" in the release radar (optional, default Europe/Berlin)
# APP_TIMEZONE=Europe/Berlin

# Anime tab (optional): sources and limits of the metadata gateway (AniList, MyAnimeList). The budget applies to the
# whole server (one IP); 40 % stay reserved for searches of the users, background refreshes only use the
# rest. ANIME_SOURCES switches sources off (e.g. only "anilist"); "jikan" stands for the MyAnimeList side.
# ANIME_ANILIST_RPM=30
# ANIME_JIKAN_RPM=60
# ANIME_SOURCES=anilist,jikan

# API keys of the instance (optional): MyAnimeList client ID (32 characters, myanimelist.net/apiconfig, App Type
# "other") instead of Jikan, Google Books key (AIza…, Books API) for the ISBN search. Both can also be stored in the
# account dialog (admins, "Für alle (Instanz)") or with "quellen setzen mal" in the console; the environment wins and
# appears there as "aus der Umgebung gesetzt". "quellen anleitung <provider>" shows the steps.
# MAL_CLIENT_ID=
# GOOGLE_BOOKS_KEY=
# Stored keys live AES-256-GCM encrypted in the database; the key for that is derived from JWT_SECRET or
# <DATA_DIR>/secret.key. Whoever has the database AND secret.key (or JWT_SECRET) can read them. If the
# secret changes, stored keys can no longer be read and have to be entered again. Instances with
# stored keys best set JWT_SECRET fixed through the environment.

# Logging (optional)
# LOG_LEVEL: debug | info (default) | warn | error | silent. `debug` additionally writes an access log of the API
#            (method, path without query, status, duration – never passwords, cookies or request bodies).
# LOG_FORMAT: text (default, easy to read in the Pterodactyl console) | json (one line per entry, for log tools)
# LOG_LEVEL=info
# LOG_FORMAT=text

# Remote scripts (scripts/check-remote.js, seed-remote.js, verify-remote.js); the server itself never reads these values.
# Target: argument > REMOTE_URL > REMOTE_HOST/REMOTE_PORT. Passwords only over https or to localhost.
# REMOTE_URL=https://manga.example.com
# REMOTE_HOST=localhost
# REMOTE_PORT=3000
# REMOTE_USER=admin
# REMOTE_PASS=
# REMOTE_ALLOW_HTTP=1   # allows plain http to another host (password in plain text)
# seed-remote.js skips existing demo series; --wipe recreates them (asks first, without a terminal only with --yes).

# Headless browser testing (optional overrides for CI/CD)
# CHROME_BIN=/usr/bin/google-chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
