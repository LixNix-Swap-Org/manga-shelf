# ==========================================
# Manga Shelf 2.0 - Environment Configuration
# ==========================================

# Server Port (Pterodactyl Panel sets this via environment or default 3000)
PORT=3000

# JSON Web Token Secret (optional, mind. 32 Zeichen, z. B. `openssl rand -hex 32`).
# Ohne Angabe wird automatisch ein zufälliges Secret erzeugt und in der Datenbank gespeichert.
# Platzhalter-Werte werden abgelehnt.
# JWT_SECRET=

# Remote Instance Sync & Testing (optional, used by check-remote.js, seed-remote.js, verify-remote.js)
REMOTE_HOST=localhost
REMOTE_PORT=3000
ADMIN_USER=admin
ADMIN_PASS=

# Headless Browser Testing (optional overrides for CI/CD)
# CHROME_BIN=/usr/bin/google-chrome
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
