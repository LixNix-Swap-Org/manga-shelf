{
  "name": "manga-shelf-backend",
  "version": "2.17.1",
  "description": "Manga Shelf Backend for Pterodactyl",
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "build:frontend": "cd frontend && npm install && npm run build",
    "package": "npm run build:frontend && node package.js",
    "release": "node release.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/browser/run.js test/browser/e2e-suite.js",
    "test:radar": "node test/browser/run.js test/browser/release-radar.js",
    "test:perf": "node test/browser/run.js test/browser/performance-suite.js",
    "test:deep": "node test/browser/run.js test/browser/deep-e2e.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.15.0",
    "puppeteer-core": "^25.12.0"
  }
}
