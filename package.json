{
  "name": "manga-shelf-backend",
  "version": "2.19.1",
  "description": "Manga Shelf Backend for Pterodactyl",
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "index.js",
    "db.js",
    "core/",
    "mangaPassion.js",
    "healthcheck.js",
    "middleware/",
    "routes/",
    "scripts/admin.js",
    "services/",
    "utils/"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "node scripts/dev.js",
    "dev:api": "node index.js",
    "build:frontend": "cd frontend && npm ci && npm run build",
    "package": "npm run build:frontend && node package.js",
    "release": "node release.js",
    "seed": "node scripts/seed.js",
    "bench": "node scripts/bench/run.js",
    "check:bundle": "node scripts/check-bundle-size.js",
    "test": "node --test test/*.test.js test/core/*.test.js test/anime/*.test.js",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "node test/browser/run.js test/browser/e2e-suite.js",
    "test:radar": "node test/browser/run.js test/browser/release-radar.js",
    "test:anime": "node test/browser/run.js test/browser/anime.js",
    "test:perf": "node test/browser/run.js test/browser/performance-suite.js",
    "test:deep": "node test/browser/run.js test/browser/deep-e2e.js",
    "lint": "eslint .",
    "build:server": "node scripts/server-bin/build-sea.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "js-yaml": "^5.4.3",
    "puppeteer-core": "^25.12.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
