    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Shopping list",
      "short_name": "Shopping",
      "description": "Pull up your missing volumes right in the bookshop",
      "url": "/?view=shopping",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Scan barcode",
      "short_name": "Scan",
      "description": "Scan a volume in the shop with a photo and match it with the collection",
      "url": "/?view=shopping&scan=1",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Release Radar",
      "short_name": "Radar",
      "description": "Pre-orders & new releases",
      "url": "/?view=radar",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Statistics",
      "short_name": "Stats",
      "description": "Collection value & reading statistics",
      "url": "/?view=stats",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "text": "share_text",
