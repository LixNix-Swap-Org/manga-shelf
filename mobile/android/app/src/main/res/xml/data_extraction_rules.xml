<?xml version="1.0" encoding="utf-8"?>
<!-- API keys and server tokens stay on the device: their Keystore key is never part of a backup or transfer. The
     collection (manga.db with its save copies, uploads/) neither: its backup is the ZIP export ("Backups" in the app). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
        <exclude domain="file" path="manga.db" />
        <exclude domain="file" path="manga.db.new" />
        <exclude domain="file" path="manga.db.old" />
        <exclude domain="file" path="manga.db.tmp" />
        <exclude domain="file" path="manga.db.seq" />
        <exclude domain="file" path="uploads" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="WSSecureStorageSharedPreferences.xml" />
        <exclude domain="file" path="manga.db" />
        <exclude domain="file" path="manga.db.new" />
        <exclude domain="file" path="manga.db.old" />
        <exclude domain="file" path="manga.db.tmp" />
        <exclude domain="file" path="manga.db.seq" />
        <exclude domain="file" path="uploads" />
    </device-transfer>
</data-extraction-rules>
