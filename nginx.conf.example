# Nginx Konfiguration für Manga Shelf
# Datei z.B. nach /etc/nginx/sites-available/manga-shelf kopieren und verlinken nach /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name manga.deinedomain.de; # <-- Ersetze dies mit deiner Domain / Subdomain

    # Weiterleitung aller HTTP-Anfragen auf sicheres HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name manga.deinedomain.de; # <-- Ersetze dies mit deiner Domain / Subdomain

    # SSL-Zertifikate (wird bei Certbot automatisch eingetragen)
    # ssl_certificate /etc/letsencrypt/live/manga.deinedomain.de/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/manga.deinedomain.de/privkey.pem;

    # WICHTIG: Erlaubt Uploads von großen Backups (.zip) und hochauflösenden Coverbildern
    client_max_body_size 100M;

    location / {
        # Lokaler Port deines Pterodactyl Servers (z. B. 25502)
        proxy_pass http://127.0.0.1:25502;
        proxy_http_version 1.1;

        # Proxy Header für HTTPS und IP-Erkennung
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Timeouts für Backups & Restore
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
        send_timeout 300;
    }
}
